# ==========================================
# Binance Spot API 連線設定
# ==========================================
# 預設 USE_TESTNET=false 為正式盤實盤模式；如需切回 Binance Spot Testnet 請改為 true 並更換測試網金鑰
USE_TESTNET=false
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key

# ==========================================
# Telegram 每日報告通知設定
# ==========================================
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# ==========================================
# v3b 資金與倉位配置參數 (以下為 bot.py 預設值)
# ==========================================
# 總淨值 (USDT + 持倉市值) 的目標投入比例；0.7 代表投入 70%、保留 30% 現金備用
DEPLOY_RATIO=0.7

# 投入部位中 BTC/USDT 與 XAUT/USDT 的分配權重 (兩者相加建議為 1.0，各佔總淨值 35%)
BTC_WEIGHT=0.5
XAUT_WEIGHT=0.5

# 最小買入與賣出門檻 (USDT)
# - 買入維持 10.0 U；賣出設 5.5 U (貼近幣安 5 U 最低下限)，避免小倉跌破 10U 後變死灰塵
MIN_ORDER_USDT=10.0
MIN_EXIT_USDT=5.5

# 期貨數據抓取失敗重試次數與間隔秒數 (用於 23:00 UTC 主掃描及 23:15/23:30/23:45 補抓)
FETCH_MAX_RETRIES=3
FETCH_RETRY_DELAY=5.0
