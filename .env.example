# ==========================================
# Binance Spot API 連線設定
# ==========================================
# 請依 bot.py 的模式選擇對應金鑰：
# - 預設 bot.py 啟用 set_sandbox_mode(True)，請填入 Binance Spot Testnet API Key
# - 若上線實盤並移除 set_sandbox_mode(True)，請填入 Binance 正式帳號現貨交易 API Key
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key

# ==========================================
# Telegram 每日報告通知設定
# ==========================================
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# ==========================================
# v3b 資金與倉位配置參數 (以下為 bot.py 預設值)
# ==========================================
# 總淨值 (USDT + 持倉市值) 的目標投入比例；0.7 代表投入 70%、保留 30% 現金備用
DEPLOY_RATIO=0.7

# 投入部位中 BTC/USDT 與 XAUT/USDT 的分配權重 (兩者相加建議為 1.0，各佔總淨值 35%)
BTC_WEIGHT=0.5
XAUT_WEIGHT=0.5

# 最小下單金額與持倉判定門檻 (USDT)；低於此價值視為零頭或空倉
MIN_ORDER_USDT=10.0
